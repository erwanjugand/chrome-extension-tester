{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && pnpm zip",
    "check:prettier": "prettier --check .",
    "check:eslint": "eslint .",
    "check:ts": "tsc --noEmit",
    "check:all": "pnpm check:prettier && pnpm check:eslint && pnpm check:ts",
    "fix:prettier": "prettier --loglevel warn --write .",
    "fix:eslint": "pnpm check:eslint --fix",
    "fix:all": "pnpm fix:prettier && pnpm fix:eslint"
  },
  "devDependencies": {
    "@types/chrome": "0.0.277",
    "@types/node": "22",
    "eslint": "9.11.1",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.6.2",
    "typescript-eslint": "8.8.0",
    "vite": "5.4.8",
    "vite-plugin-web-extension": "4.2.0"
  }
}
