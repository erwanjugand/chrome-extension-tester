    "chrome-types": "^0.1.321",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0",
    "vite": "6.0.11",
    "vite-plugin-web-extension": "4.4.3"
  }
}
