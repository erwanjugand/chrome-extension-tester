{
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm build:mv3 && pnpm build:mv2",
    "build:mv3": "vite build --mode mv3",
    "build:mv2": "vite build --mode mv2",
    "check:prettier": "prettier --check .",
    "check:lint": "oxlint",
    "check:ts": "tsc --noEmit",
    "check:all": "pnpm check:prettier && pnpm check:lint && pnpm check:ts",
    "fix:prettier": "prettier --log-level warn --write .",
    "fix:lint": "pnpm check:lint --fix --fix-suggestions",
    "fix:all": "pnpm fix:prettier && pnpm fix:lint"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "0.1.3",
    "@types/chrome": "0.1.32",
    "@types/node": "24.10.4",
    "chrome-types": "0.1.404",
    "oxlint": "1.36.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vite-plugin-web-extension": "4.5.0"
  }
}
