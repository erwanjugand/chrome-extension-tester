{
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check:prettier": "prettier --check .",
    "check:oxlint": "oxlint",
    "check:ts": "tsc --noEmit",
