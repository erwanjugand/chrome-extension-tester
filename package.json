    "eslint-config-prettier": "10.1.1",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.28.0",
    "vite": "6.2.3",
    "vite-plugin-web-extension": "4.4.3"
  }
}
